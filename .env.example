# ============================================================
# CONFIGURACION DE LA TARJETA DE FIDELIDAD - APPLE WALLET
# Copia este archivo como .env y rellena con tus datos reales
# ============================================================

# --- Servidor ---
PORT=3000
# Entorno: development | production. En production se exige HTTPS y secretos seguros.
NODE_ENV=development
# Pon "true" si el servidor esta detras de un proxy/balanceador (Nginx, Render, etc.)
TRUST_PROXY=false
# URL publica del servidor (debe ser HTTPS en produccion).
# Apple la usa para registrar y actualizar los passes.
WEB_SERVICE_URL=https://tucafeteria.com

# --- Base de datos (PostgreSQL) ---
# Cadena de conexion. En local con Docker/Postgres por defecto:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fidelidad
# Pon "true" si tu proveedor exige SSL (Render, Supabase, Neon, RDS, etc.)
PGSSL=false
# Numero maximo de conexiones simultaneas del pool
PG_POOL_MAX=10

# --- Cola de notificaciones push (BullMQ + Redis) ---
# Si lo dejas vacio, los push se envian directos (modo simple, sin cola).
# Con Redis, los envios van a una cola con reintentos y se procesan aparte.
REDIS_URL=redis://localhost:6379
# Cuantos push procesa cada worker a la vez
PUSH_WORKER_CONCURRENCY=5
# "true" para que el propio servidor web procese la cola (comodo en desarrollo).
# En produccion dejalo en "false" y corre `npm run worker` en otro proceso.
START_WORKER=false

# --- Datos de tu Apple Developer Account ---
# Pass Type ID creado en developer.apple.com (empieza con "pass.")
PASS_TYPE_IDENTIFIER=pass.com.tucafeteria.fidelidad
# Team ID (10 caracteres) de tu cuenta de Apple Developer
TEAM_IDENTIFIER=ABCDE12345

# --- Datos de tu negocio (se muestran en la tarjeta) ---
ORGANIZATION_NAME=Mi Cafeteria
LOGO_TEXT=Mi Cafeteria

# --- Programa de fidelidad ---
# Numero de sellos/cafes necesarios para obtener la recompensa
SELLOS_PARA_RECOMPENSA=10

# --- Certificados (rutas a los archivos en /certs) ---
# Certificado del Pass Type ID exportado como .pem
PASS_CERT_PATH=./certs/signerCert.pem
PASS_KEY_PATH=./certs/signerKey.pem
# Contrasena de la clave privada (si la tiene)
PASS_KEY_PASSPHRASE=
# Certificado intermedio Apple WWDR (.pem)
WWDR_CERT_PATH=./certs/wwdr.pem

# --- APNs (notificaciones push para actualizar passes) ---
# Mismo certificado del Pass Type ID sirve para APNs.
# Topic de APNs = el Pass Type Identifier
APNS_KEY_PATH=./certs/signerKey.pem
APNS_CERT_PATH=./certs/signerCert.pem

# --- Token de autenticacion del web service ---
# Cadena aleatoria y secreta. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUTHENTICATION_TOKEN=cambia_esto_por_un_token_secreto

# --- Clave para proteger los endpoints de administracion ---
ADMIN_API_KEY=cambia_esto_por_una_clave_admin

# --- SaaS: clave maestra del operador de la plataforma ---
# Se usa para dar de alta y gestionar cafeterias (tenants) en /platform.
# Cada cafeteria recibe luego su propia API key para /admin.
PLATFORM_ADMIN_KEY=cambia_esto_por_una_clave_de_plataforma

# --- Login: secreto para firmar los tokens de sesion (JWT HS256) ---
# Minimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_de_sesion_largo

# --- Operador de la plataforma (para el script create-owner) ---
# Se usan solo al ejecutar: npm run create-owner
PLATFORM_OWNER_EMAIL=tu@correo.com
PLATFORM_OWNER_PASSWORD=cambia_esta_contrasena
PLATFORM_OWNER_NAME=Operador

# --- Seguridad: cifrado de datos de clientes (PII) en reposo ---
# Clave AES-256 de 32 bytes en hexadecimal (64 caracteres). OBLIGATORIA.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: guarda esta clave en un lugar seguro. Si la pierdes, no podras
# descifrar los nombres/emails de tus clientes. Si la cambias, los datos
# existentes quedaran ilegibles.
ENCRYPTION_KEY=

# --- Rate limiting (proteccion anti fuerza bruta / abuso) ---
# Ventana de tiempo en milisegundos y maximo de peticiones por IP en esa ventana.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WALLET_MAX=120
RATE_LIMIT_ADMIN_MAX=60
